# Settings for deploy/compose/docker-compose.yml. Copy to .env next to the compose file.
# Generate URL-safe passwords, e.g.: openssl rand -hex 24

# Postgres superuser/owner password (used by migrations).
POSTGRES_PASSWORD=
# Password for the fiscus_app role the api connects as (min 12 chars).
APP_DATABASE_PASSWORD=
# Password for the fiscus_worker role the worker connects as. Unset: the same as the app's.
# WORKER_DATABASE_PASSWORD=

# Master encryption key: generate with `openssl rand -base64 32`.
# BACK THIS UP SEPARATELY FROM YOUR DATABASE BACKUPS. Without it, encrypted data (bank
# connections, notes, receipts) is permanently unrecoverable, and with it plus a stolen
# backup, an attacker can read that data. See docs/security/encryption.md.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
# Only while rotating the master key (docs/security/encryption.md): the key being replaced, its
# version, and a password for the maintenance role that re-wraps household keys.
# APP_ENCRYPTION_KEY_PREVIOUS=
# APP_ENCRYPTION_KEY_PREVIOUS_VERSION=
# MAINTENANCE_DATABASE_PASSWORD=

# Backups: a database dump every day (the last 7 kept), and before each upgrade. Encrypt them to
# an age public key made ON YOUR OWN COMPUTER with `age-keygen -o fiscus-backup-key.txt`; keep
# that file (the private key) off this server, or the backups can't be restored. Unset: written
# unencrypted. See docs/security/backups.md.
BACKUP_AGE_RECIPIENTS=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7

# Bank connections through Plaid (README, Plaid keys): the server's own keys, from
# dashboard.plaid.com. Set all three or none; unset, Plaid is unavailable unless a household has
# its own keys. PLAID_ENV is sandbox (test data only) or production.
# Don't switch a real instance to sandbox: run sandbox as a separate stack instead.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=production
# Optional: for banks whose sign-in is on their own site (OAuth). An https URL that is also
# listed in Plaid's dashboard.
# PLAID_REDIRECT_URI=

# Image tag to run: pin a release (e.g. 1.2.3) so upgrades happen when you choose. Releases:
# https://github.com/ahanel13/fiscus/releases
FISCUS_VERSION=latest
# Where the web UI listens. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 to expose on the LAN.
FISCUS_BIND=127.0.0.1
FISCUS_PORT=8080

# The address people use to reach Fiscus (used in invite and password-reset links).
FISCUS_PUBLIC_URL=http://localhost:8080
# Who can create accounts: open, invite_only, or closed. The first account is created with the
# one-time setup token printed in the api logs: docker compose logs api | grep "setup token"
FISCUS_SIGNUP_MODE=invite_only
# Session cookies are HTTPS-only (localhost is exempt in browsers). Set false ONLY for plain-HTTP
# LAN access; sessions can then be stolen by anyone on the network. Prefer a TLS reverse proxy.
FISCUS_COOKIE_SECURE=true
# Fiscus is AGPL-3.0: if you run a MODIFIED version for other people, set this to where they
# can get your source code. The app links to it. Leave empty to link to upstream.
FISCUS_SOURCE_URL=

LOG_LEVEL=info
