# Fiscus environment variables.
# Generated by `pnpm env:example` from the service definitions. Do not edit by hand.
# Any variable can instead be supplied as NAME_FILE=/path/to/file (Docker/Proxmox secrets).

# Runtime mode.
# Used by: api, worker, mcp
NODE_ENV=development

# Minimum log level: fatal, error, warn, info, debug, trace.
# Used by: api, worker, mcp, migrate, backup, rotate-key
LOG_LEVEL=info

# Interface to bind.
# Used by: api
HOST=0.0.0.0

# Port to listen on.
# Used by: api
PORT=3000

# Postgres URL. Services connect as fiscus_app; the migrate job as the schema owner. (secret)
# Used by: api, worker
DATABASE_URL=

# Master encryption key: 32 random bytes, base64 (`openssl rand -base64 32`). Back it up separately from database dumps; without it, encrypted data is unrecoverable. (secret)
# Used by: api, worker, rotate-key
APP_ENCRYPTION_KEY=

# Version number of APP_ENCRYPTION_KEY. Increase it when rotating the key.
# Used by: api, worker, rotate-key
APP_ENCRYPTION_KEY_VERSION=1

# During a key rotation only: the previous APP_ENCRYPTION_KEY, so data it protects can still be read until fiscus-rotate-key has moved it to the new key (docs/security/encryption.md). (secret)
# Used by: api, worker, rotate-key
APP_ENCRYPTION_KEY_PREVIOUS=

# The version APP_ENCRYPTION_KEY_PREVIOUS had (set with it).
# Used by: api, worker, rotate-key
APP_ENCRYPTION_KEY_PREVIOUS_VERSION=

# Base URL people use to reach Fiscus. Used in links (invites, password resets).
# Used by: api
PUBLIC_URL=http://localhost:8080

# Who can create an account: open, invite_only, or closed (ADR 0005).
# Used by: api
SIGNUP_MODE=invite_only

# Mark session cookies Secure (HTTPS only; browsers also allow localhost). Disable only for plain-HTTP LAN access, which exposes sessions to network snooping.
# Used by: api
COOKIE_SECURE=true

# Trust X-Forwarded-For from a reverse proxy, for client IPs in rate limits and audit logs. Enable only when the api is reachable solely through that proxy.
# Used by: api
TRUST_PROXY=false

# Valkey (or Redis) URL, where rate limits are counted so they hold across api replicas and restarts. Unset: each api process counts its own. (secret)
# Used by: api
VALKEY_URL=

# The server's Plaid client id. Set PLAID_CLIENT_ID, PLAID_SECRET and PLAID_ENV together, or none: without them, Plaid is unavailable unless a household has its own keys.
# Used by: api, worker
PLAID_CLIENT_ID=

# The server's Plaid secret, for PLAID_ENV's environment. (secret)
# Used by: api, worker
PLAID_SECRET=

# Plaid environment: sandbox (test data only) or production (real banks). Run sandbox as a separate instance rather than switching a real one (README, Plaid keys).
# Used by: api, worker
PLAID_ENV=

# Optional: the https URL Plaid Link returns to after a bank's own sign-in page (OAuth): this server's origin followed by /connect/plaid/oauth. It must also be listed in Plaid's dashboard.
# Used by: api, worker
PLAID_REDIRECT_URI=

# Tests only: send Plaid requests to this URL instead of Plaid's. Ignored unless PLAID_ENV=sandbox.
# Used by: api, worker
PLAID_API_BASE_URL=

# Hosts a SimpleFIN setup token may point at, comma-separated. Defaults to the Bridge (bridge.simplefin.org, beta-bridge.simplefin.org); a token pointing anywhere else is refused.
# Used by: api, worker
SIMPLEFIN_BRIDGE_HOSTS=bridge.simplefin.org,beta-bridge.simplefin.org

# Tests only: allow tokens on plain http, for a local stub Bridge.
# Used by: api, worker
SIMPLEFIN_ALLOW_HTTP=

# Port for the worker health endpoints.
# Used by: worker
HEALTH_PORT=3001

# Hours between scheduled bank syncs, overriding the instance admin's setting (Server → Bank connections). Leave empty to use that setting (default 4).
# Used by: worker
SYNC_INTERVAL_HOURS=

# Seconds between the worker's checks for connections that are due to sync.
# Used by: worker
SYNC_POLL_SECONDS=5

# Postgres URL for migrations and seeding, as the schema owner (not fiscus_app). (secret)
# Used by: migrate, backup
MIGRATION_DATABASE_URL=

# If set, migrate enables login for the fiscus_app role with this password. (secret)
# Used by: migrate
APP_DATABASE_PASSWORD=

# If set, migrate enables login for the fiscus_worker role with this password: the role the worker connects as, the only one system context works for. (secret)
# Used by: migrate
WORKER_DATABASE_PASSWORD=

# If set, migrate enables login for the fiscus_maintenance (BYPASSRLS) role with this password. (secret)
# Used by: migrate
MAINTENANCE_DATABASE_PASSWORD=

# Before applying pending migrations, write a pg_dump to MIGRATE_BACKUP_DIR (docs/design/upgrades.md §5). Turn off only if the database is backed up another way.
# Used by: migrate
MIGRATE_BACKUP=true

# Where pre-migration dumps go (a volume in the compose stack).
# Used by: migrate
MIGRATE_BACKUP_DIR=

# How many pre-migration dumps to keep; older ones are deleted.
# Used by: migrate
MIGRATE_BACKUP_KEEP=

# age public keys (age1…) that backups are encrypted to; only their private keys, kept off the server, can restore them. Unset: backups are written unencrypted (docs/security/backups.md).
# Used by: migrate, backup
BACKUP_AGE_RECIPIENTS=

# Where scheduled dumps go (the same volume as the pre-upgrade ones in compose).
# Used by: backup
BACKUP_DIR=

# Hours between backups. 0: take one now and exit (for cron, or a restore drill).
# Used by: backup
BACKUP_INTERVAL_HOURS=

# How many scheduled dumps to keep; older ones are deleted.
# Used by: backup
BACKUP_KEEP=

# Postgres URL as fiscus_maintenance, the role allowed to reach every household for key rotation and other maintenance jobs. (secret)
# Used by: rotate-key
MAINTENANCE_DATABASE_URL=
