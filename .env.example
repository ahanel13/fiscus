# Fiscus environment variables.
# Generated by `pnpm env:example` from the service definitions. Do not edit by hand.
# Any variable can instead be supplied as NAME_FILE=/path/to/file (Docker/Proxmox secrets).

# Runtime mode.
# Used by: api, worker, mcp
NODE_ENV=development

# Minimum log level: fatal, error, warn, info, debug, trace.
# Used by: api, worker, mcp, migrate, backup
LOG_LEVEL=info

# Interface to bind.
# Used by: api
HOST=0.0.0.0

# Port to listen on.
# Used by: api
PORT=3000

# Postgres URL. Services connect as fiscus_app; the migrate job as the schema owner. (secret)
# Used by: api, worker
DATABASE_URL=

# Master encryption key: 32 random bytes, base64 (`openssl rand -base64 32`). Back it up separately from database dumps; without it, encrypted data is unrecoverable. (secret)
# Used by: api, worker
APP_ENCRYPTION_KEY=

# Version number of APP_ENCRYPTION_KEY. Increase it when rotating the key.
# Used by: api, worker
APP_ENCRYPTION_KEY_VERSION=1

# Base URL people use to reach Fiscus. Used in links (invites, password resets).
# Used by: api
PUBLIC_URL=http://localhost:8080

# Who can create an account: open, invite_only, or closed (ADR 0005).
# Used by: api
SIGNUP_MODE=invite_only

# Mark session cookies Secure (HTTPS only; browsers also allow localhost). Disable only for plain-HTTP LAN access, which exposes sessions to network snooping.
# Used by: api
COOKIE_SECURE=true

# Trust X-Forwarded-For from a reverse proxy, for client IPs in rate limits and audit logs. Enable only when the api is reachable solely through that proxy.
# Used by: api
TRUST_PROXY=false

# Port for the worker health endpoints.
# Used by: worker
HEALTH_PORT=3001

# Postgres URL for migrations and seeding, as the schema owner (not fiscus_app). (secret)
# Used by: migrate, backup
MIGRATION_DATABASE_URL=

# If set, migrate enables login for the fiscus_app role with this password. (secret)
# Used by: migrate
APP_DATABASE_PASSWORD=

# If set, migrate enables login for the fiscus_maintenance (BYPASSRLS) role with this password. (secret)
# Used by: migrate
MAINTENANCE_DATABASE_PASSWORD=

# Before applying pending migrations, write a pg_dump to MIGRATE_BACKUP_DIR (docs/design/upgrades.md §5). Turn off only if the database is backed up another way.
# Used by: migrate
MIGRATE_BACKUP=true

# Where pre-migration dumps go (a volume in the compose stack).
# Used by: migrate
MIGRATE_BACKUP_DIR=

# How many pre-migration dumps to keep; older ones are deleted.
# Used by: migrate
MIGRATE_BACKUP_KEEP=

# age public keys (age1…) that backups are encrypted to; only their private keys, kept off the server, can restore them. Unset: backups are written unencrypted (docs/security/backups.md).
# Used by: migrate, backup
BACKUP_AGE_RECIPIENTS=

# Where scheduled dumps go (the same volume as the pre-upgrade ones in compose).
# Used by: backup
BACKUP_DIR=

# Hours between backups. 0: take one now and exit (for cron, or a restore drill).
# Used by: backup
BACKUP_INTERVAL_HOURS=

# How many scheduled dumps to keep; older ones are deleted.
# Used by: backup
BACKUP_KEEP=
